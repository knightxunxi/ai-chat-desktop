QWidget {
    color: #1f2933;
    selection-background-color: #bfdbfe;
    selection-color: #111827;
}

QMainWindow {
    background: #f4f6f8;
}

QWidget#centralRoot {
    background: #f7f8fa;
}

QWidget#mainPanel {
    background: #f7f8fa;
}

QFrame#sidebar {
    background: #eef1f4;
    border-right: 1px solid #d8dee6;
}

QPushButton {
    min-height: 34px;
    padding: 6px 14px;
    border: 1px solid #c8d0da;
    border-radius: 6px;
    background: #ffffff;
    color: #1f2933;
    font-size: 14px;
}

QPushButton:hover {
    background: #f6f8fb;
}

QPushButton:pressed {
    background: #e9eef5;
}

QPushButton:disabled {
    color: #9aa5b1;
    background: #edf1f5;
    border-color: #d8dee6;
}

QPushButton#newChatButton {
    background: #1f7a68;
    border-color: #1f7a68;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#newChatButton:hover {
    background: #176b5b;
}

QPushButton#deleteChatButton {
    color: #9f1239;
}

QPushButton#deleteChatButton:hover {
    background: #fff1f2;
    border-color: #fda4af;
}

QPushButton#sendButton {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#sendButton:hover {
    background: #1d4ed8;
}

QPushButton#sendButton[stopMode="true"] {
    background: #dc2626;
    border-color: #dc2626;
}

QPushButton#sendButton[stopMode="true"]:hover {
    background: #b91c1c;
    border-color: #b91c1c;
}

QPushButton#sendButton:disabled {
    background: #d6deea;
    border-color: #d6deea;
    color: #7b8794;
}

QPushButton#retryButton {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #334155;
    font-weight: 600;
}

QPushButton#retryButton:hover {
    background: #e2e8f0;
}

QListWidget#sessionList {
    border: none;
    background: transparent;
    outline: none;
    color: #1f2933;
}

QLineEdit#sessionSearchEdit {
    min-height: 32px;
    padding: 5px 9px;
}

QListWidget#sessionList::item {
    min-height: 36px;
    padding: 6px 10px;
    border-radius: 6px;
}

QListWidget#sessionList::item:selected {
    background: #111827;
    color: #ffffff;
}

QFrame#chatHeader {
    background: #ffffff;
    border-bottom: 1px solid #dfe5ec;
}

QLabel#modelLabel {
    color: #111827;
    font-size: 16px;
    font-weight: 600;
}

QLabel#personaLabel {
    color: #5f6c7b;
    font-size: 13px;
}

QScrollArea#chatScrollArea {
    background: #f7f8fa;
}

QScrollArea#chatScrollArea > QWidget {
    background: #f7f8fa;
}

QScrollBar:vertical {
    width: 12px;
    margin: 0;
    background: #e5e7eb;
}

QScrollBar::handle:vertical {
    min-height: 36px;
    border-radius: 6px;
    background: #64748b;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QWidget#chatContainer {
    background: #f7f8fa;
}

QFrame#assistantMessage,
QFrame#userMessage,
QFrame#systemMessage {
    padding: 0;
    border: 1px solid #cfd8e3;
    border-radius: 8px;
}

QFrame#assistantMessage {
    background: #ffffff;
}

QFrame#userMessage {
    background: #dbeafe;
    border-color: #93c5fd;
}

QFrame#systemMessage {
    background: #fff7e8;
    border-color: #e7c77f;
}

QLabel#messageRole {
    color: #374151;
    font-size: 12px;
    font-weight: 600;
}

QLabel#messageContent {
    color: #1f2937;
    font-size: 14px;
}

QPushButton#copyMessageButton {
    min-height: 0;
    padding: 2px 8px;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    background: #f8fafc;
    color: #334155;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#copyMessageButton:hover {
    background: #e2e8f0;
    border-color: #94a3b8;
}

QPushButton#copyMessageButton:pressed {
    background: #cbd5e1;
}

QPushButton#copyMessageButton:disabled {
    background: #f1f5f9;
    border-color: #e2e8f0;
    color: #94a3b8;
}

QFrame#composer {
    background: #ffffff;
    border-top: 1px solid #dfe5ec;
}

QDialog {
    background: #f7f8fa;
}

QLabel#settingsTitle {
    color: #111827;
    font-size: 18px;
    font-weight: 700;
}

QLabel#logViewerTitle {
    color: #111827;
    font-size: 18px;
    font-weight: 700;
}

QLabel#logPathLabel {
    color: #5f6c7b;
    font-size: 12px;
}

QPlainTextEdit#logViewerText {
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #0f172a;
    color: #e2e8f0;
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 12px;
}

QLineEdit,
QComboBox {
    min-height: 34px;
    padding: 6px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #ffffff;
    color: #111827;
    font-size: 14px;
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #2563eb;
}

QTextEdit#messageInput,
QTextEdit#rolePromptEdit {
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #ffffff;
    color: #111827;
    font-size: 14px;
}

QTextEdit#messageInput:focus,
QTextEdit#rolePromptEdit:focus {
    border-color: #2563eb;
}
